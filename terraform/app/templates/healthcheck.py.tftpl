# Container health check of the LiteLLM container. container.tf renders it,
# drops the comment lines and passes it to python3 -c inside a double-quoted
# shell string, so the code holds no double quotes, dollar signs, backslashes
# or backticks. Standard library only; python3 ships in the image.
import json, os, sys, urllib.request as request

# 1. Liveliness: LiteLLM must answer on its liveliness path.
try:
    request.urlopen('${liveliness_url}', timeout=5).close()
except Exception:
    sys.exit(1)

# 2. Memory: unhealthy when the whole task's memory, without reclaimable page
# cache, reaches the recycle threshold. ECS then starts a replacement task
# before it stops this one. Fails open: if the task metadata endpoint is
# unavailable or its payload unexpected, liveliness alone decides, so a
# metadata problem cannot take healthy tasks out of service.
metadata = os.environ.get('ECS_CONTAINER_METADATA_URI_V4')
if not metadata:
    sys.exit(0)
try:
    with request.urlopen(metadata + '/task/stats', timeout=3) as response:
        stats = json.load(response)
    used = 0
    for container in stats.values():
        memory = (container or {}).get('memory_stats') or {}
        detail = memory.get('stats') or {}
        # Page cache that the kernel can reclaim: inactive_file (cgroup v2),
        # total_inactive_file (cgroup v1).
        reclaimable = detail.get('inactive_file', detail.get('total_inactive_file', 0))
        used += max(memory.get('usage', 0) - reclaimable, 0)
except Exception:
    sys.exit(0)
if used >= ${threshold_mib} * 2**20:
    # Health-check output is not logged by ECS; write to the main process's
    # stdout so the reason appears in the container log.
    try:
        with open('/proc/1/fd/1', 'w') as log:
            log.write(json.dumps({'level': 'WARNING', 'message': 'health check: task memory %d MiB >= recycle threshold ${threshold_mib} MiB' % (used // 2**20)}) + chr(10))
    except OSError:
        pass
    sys.exit(1)
